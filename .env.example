# Copy to .env. Do not put production secrets here.
# *_REF values are secret-store references; local development may also set
# the resolved values below for loopback-only operation.

# LIVE_WATCH | LIVE_PAPER_HEURISTIC | LIVE_PAPER_SHADOW_ML |
# LIVE_PAPER_ML | REPLAY
PUMPHOUND_MODE=LIVE_WATCH
PUMPHOUND_HEURISTIC_POLICY_PATH=configs/heuristic-v1.json
# Required only for LIVE_PAPER_ML. Heuristic and shadow modes do not use it
# to authorize orders.
PUMPHOUND_PAPER_POLICY_PATH=
PUMPHOUND_DATA_DIR=./data
PUMPHOUND_API_BIND=127.0.0.1:8080
PUMPHOUND_DESKTOP_DEV=1
# Shared endpoint; request authority selects CONTROL or SHADOW behavior.
PUMPHOUND_ML_PREDICT_URL=http://127.0.0.1:8091/predict

# Labelled replay only. GUI must show REPLAY. Not live mainnet.
PUMPHOUND_REPLAY_PATH=fixtures/chain/sample_logs.json
PUMPHOUND_REPLAY_CANONICAL=fixtures/chain/decoded_events.json
PUMPHOUND_REPLAY_SPEED=0

# Stores (local compose defaults; override for remote)
PUMPHOUND_POSTGRES_DSN=postgres://pumphound:pumphound@127.0.0.1:5433/pumphound
PUMPHOUND_POSTGRES_DSN_REF=
PUMPHOUND_CLICKHOUSE_URL=http://127.0.0.1:8123
PUMPHOUND_CLICKHOUSE_USER=pumphound
PUMPHOUND_CLICKHOUSE_PASSWORD=pumphound
PUMPHOUND_CLICKHOUSE_CREDENTIAL_REF=
PUMPHOUND_NATS_URL=nats://127.0.0.1:4222
PUMPHOUND_NATS_CREDENTIAL_REF=

# Chain sources. Leave Helius empty to use public RPC fallback.
PUMPHOUND_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PUMPHOUND_SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
PUMPHOUND_SOLANA_RPC_URL_REF=
PUMPHOUND_SOLANA_WS_URL_REF=
PUMPHOUND_HELIUS_API_KEY=
PUMPHOUND_HELIUS_KEY_REF=
PUMPHOUND_LASERSTREAM_ENDPOINT=https://laserstream-mainnet-ewr.helius-rpc.com
PUMPHOUND_LASERSTREAM_ENTITLED=0
PUMPHOUND_LIVE_FETCH_TRANSACTIONS=0

# Optional enrichment (omit to degrade that source)
PUMPHOUND_BIRDEYE_KEY=
PUMPHOUND_BIRDEYE_KEY_REF=
PUMPHOUND_JUPITER_KEY=
PUMPHOUND_JUPITER_KEY_REF=
PUMPHOUND_PYTH_KEY=
PUMPHOUND_PYTH_KEY_REF=
PUMPHOUND_MONTHLY_PROVIDER_BUDGET_USD=50

# Candidate-only Helius enrichment. Disabled and not entitled by default.
# The API key is shared with the collector but is never returned or logged.
PUMPHOUND_ENRICHMENT_CONFIG_PATH=configs/enrichment-v1.json
PUMPHOUND_ENRICHMENT_ENABLED=0
PUMPHOUND_HELIUS_ENRICHMENT_ENTITLED=0
PUMPHOUND_HELIUS_ENRICHMENT_RPC_URL=https://mainnet.helius-rpc.com
PUMPHOUND_ENRICHMENT_DAILY_CREDITS=500
PUMPHOUND_ENRICHMENT_MONTHLY_CREDITS=5000
PUMPHOUND_ENRICHMENT_PER_CANDIDATE_CREDITS=100
PUMPHOUND_ENRICHMENT_MAX_CANDIDATES_PER_HOUR=10
PUMPHOUND_ENRICHMENT_MAX_WALLETS_PER_CANDIDATE=10
PUMPHOUND_ENRICHMENT_LEVEL2_ENABLED=0

# Optional investigator
PUMPHOUND_AI_PROVIDER=none
# Local OpenAI-compatible endpoint (used only when provider=local)
PUMPHOUND_AI_BASE_URL=http://127.0.0.1:11434/v1
PUMPHOUND_AI_MODEL=qwen3:14b
PUMPHOUND_AI_KEY=
PUMPHOUND_AI_KEY_REF=
# SiliconFlow OpenAI-compatible endpoint (used only when provider=siliconflow)
PUMPHOUND_SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
PUMPHOUND_SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
PUMPHOUND_SILICONFLOW_API_KEY=
PUMPHOUND_SILICONFLOW_API_KEY_REF=
PUMPHOUND_AI_RESPONSE_FORMAT=auto
PUMPHOUND_AI_MAX_TOKENS=900
PUMPHOUND_INVESTIGATOR_JOURNAL=data/journal/investigator.jsonl

# Program IDs must match vendored IDL address fields
PUMPHOUND_PUMP_PROGRAM=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
PUMPHOUND_PUMPSWAP_PROGRAM=pAMMBay6oceH9fJKBRHGP5D4bD4sWpmSwMn52FMfXEA
PUMPHOUND_PUMP_FEES_PROGRAM=pfeeUxB6jkeY1Hxd7CsFCAjcbHA9rWtchMGdZ6VojVZ

# Native SOL wrapped mint and USDC
PUMPHOUND_WSOL_MINT=So11111111111111111111111111111111111111112
PUMPHOUND_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
